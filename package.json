{
  "name": "marmit",
  "version": "0.1.0",
  "description": "A gooey, physics-driven floating toolbar with built-in controls, for React, Vue, Svelte, Solid, web components and plain JavaScript",
  "type": "module",
  "sideEffects": [
    "./dist/element/register.js",
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla/index.d.ts",
        "default": "./dist/vanilla/index.js"
      },
      "require": {
        "types": "./dist/vanilla/index.d.cts",
        "default": "./dist/vanilla/index.cjs"
      }
    },
    "./vanilla/browser.js": "./dist/vanilla/browser.global.js",
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte/index.d.ts",
        "default": "./dist/svelte/index.js"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid/index.d.ts",
        "default": "./dist/solid/index.js"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element/index.d.ts",
        "default": "./dist/element/index.js"
      }
    },
    "./element/register": {
      "import": {
        "types": "./dist/element/register.d.ts",
        "default": "./dist/element/register.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && cat src/core/styles.css src/core/parts/num.css src/core/parts/slider.css src/core/parts/fields.css src/core/parts/anchor.css src/core/parts/pad.css src/core/parts/transition.css src/core/parts/gradient.css src/core/parts/color.css > dist/styles.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node test/browser.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "solid-js": ">=1.6.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "puppeteer-core": "^25.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.20",
    "svelte": "^5.59.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.46"
  },
  "keywords": [
    "toolbar",
    "dock",
    "gooey",
    "metaball",
    "spring",
    "physics",
    "menu bar",
    "controls",
    "react",
    "vue",
    "svelte",
    "solid",
    "web component",
    "vanilla"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teoaliano/marmit.git"
  },
  "homepage": "https://github.com/teoaliano/marmit#readme",
  "bugs": {
    "url": "https://github.com/teoaliano/marmit/issues"
  }
}
